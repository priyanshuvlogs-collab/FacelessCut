# FacelessCut local/dev defaults.
# The app boots with USE_MOCK=true so the UI and pipeline work without paid keys.

USE_MOCK=true
DATABASE_URL="file:./dev.db"

S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
SHOTSTACK_OWNER_ID=

APP_URL=http://localhost:3000
